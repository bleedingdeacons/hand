<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<application android:allowBackup="true" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round" android:supportsRtl="true"></application>

	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<uses-permission android:name="android.permission.INTERNET" />

	<!--
		Runtime permission on Android 13+. Without it the handset cannot
		alert a responder while the app is closed, which is most of the
		point of the app — so it is asked for explicitly at sign-in and the
		answer is surfaced rather than swallowed.
	-->
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

	<!--
		Turns an alert into an incoming call: the system launches the
		activity over the lock screen rather than showing a heads-up
		banner. Android 14 restricts this to apps whose core function is
		calling or alarms — which this is — and grants it by default for
		them, revocable by the user. A revoked permission degrades to a
		heads-up notification, which still sounds.
	-->
	<uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

	<!-- The alarm needs to sound and shake with the screen off. -->
	<uses-permission android:name="android.permission.VIBRATE" />
	<uses-permission android:name="android.permission.WAKE_LOCK" />

	<!--
		Lets the app ask to be exempted from battery optimisation, which it
		does at sign-in — see PlatformAlertPresenter.RequestBatteryExemption
		for what the exemption actually buys and why a duty phone needs it.

		This permission sat here declared and unrequested for a while, and
		the symptom was maddening: push worked perfectly under a debugger,
		which pins the app to the ACTIVE standby bucket, and failed on a
		real handset left alone, which drifts to RARE. If the request is
		ever removed, remove this line with it rather than leaving the
		declaration to imply a behaviour that is not there.
	-->
	<uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

	<!-- Restarts the poll after a reboot, so a handset left on the rota
	     overnight is still listening in the morning. -->
	<uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
</manifest>
