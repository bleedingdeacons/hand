<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		Required before LocalAuthentication may evaluate a biometric policy
		on a Face ID device. An app that asks without it is terminated by
		the system rather than refused, so this is not optional decoration -
		see AppLock.apple.cs. The wording is shown in Apple's own prompt.
	-->
	<key>NSFaceIDUsageDescription</key>
	<string>Hand asks for your face or fingerprint before opening, so that alerts and callers' details on this handset stay yours.</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>XSAppIconAssets</key>
	<string>Assets.xcassets/appicon.appiconset</string>
	<!--
		Claims the hand:// scheme so iOS routes the SSO redirect back into
		the app. Without it ASWebAuthenticationSession has nowhere to
		return to and sign-in hangs on the sheet until the responder gives
		up. The scheme must match ReachClient.CallbackScheme and Reach's
		own DeviceRedirectValidator::APP_SCHEME.
	-->
	<!--
		Remote notifications, which Reach's alert push needs twice over.

		Its `aps` carries `content-available: 1`, so iOS wakes a merely
		backgrounded app to start the looping alarm - the 30-second payload
		sound cannot keep going on its own. Without this key that wake never
		happens and the alert is a single chime.

		It also carries `mutable-content: 1`, which is what launches the
		notification service extension that decrypts the payload. That one
		runs without this key, but a build that shows the alert and cannot
		sound it is not the app anyone asked for.
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.thebleedingdeacons.intergroup.hand</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>hand</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
