<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TheBleedingDeacons.Intergroup.Hand.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:TheBleedingDeacons.Intergroup.Hand.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="Hand">

    <!--
        Two top-level routes and nothing else. This is a duty handset: the
        only questions it answers are "am I signed in" and "is anybody
        waiting", and a flyout full of navigation would be one more thing
        between a responder and the acknowledge button.
    -->
    <ShellContent
        Route="signin"
        ContentTemplate="{DataTemplate views:SignInPage}"
        Shell.NavBarIsVisible="False" />

    <ShellContent
        Route="alerts"
        ContentTemplate="{DataTemplate views:AlertsPage}"
        Shell.NavBarIsVisible="False" />

</Shell>
