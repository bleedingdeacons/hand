<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TheBleedingDeacons.Intergroup.Hand.Views.LockPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:TheBleedingDeacons.Intergroup.Hand.ViewModels"
    x:DataType="vm:LockViewModel"
    Title="Locked">

    <!--
        Deliberately bare. Nothing on this page may say who is on duty,
        what is outstanding, or who rang - that is the whole point of it,
        and a "1 alert waiting" line here would give away exactly what the
        responder turned the lock on to keep private.

        It is also not on screen for long: the prompt is raised as soon as
        the page appears, so what is drawn underneath is mostly what shows
        through a system dialog and what is left behind if it is refused.
    -->

    <VerticalStackLayout Padding="24,40" Spacing="20" VerticalOptions="Center">

        <Label
            Text="Hand"
            FontSize="34"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <Label
            Text="Locked"
            FontSize="20"
            Opacity="0.7"
            HorizontalOptions="Center" />

        <Label
            Text="Touch the fingerprint sensor to open this handset."
            FontSize="14"
            Opacity="0.7"
            HorizontalTextAlignment="Center"
            HorizontalOptions="Center" />

        <Button
            Text="Unlock"
            HeightRequest="50"
            Margin="0,12,0,0"
            Command="{Binding UnlockCommand}" />

        <ActivityIndicator
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            HorizontalOptions="Center" />

        <Label
            Text="{Binding StatusMessage}"
            TextColor="#B3261E"
            FontSize="14"
            HorizontalTextAlignment="Center"
            HorizontalOptions="Center" />

        <!--
            The way out of a fingerprint that will not take. Quiet, and
            last, because it costs the enrolment - but it is here, because
            a duty handset nobody can open is worse than one that has to
            be signed in again. See LockViewModel.
        -->
        <Button
            Text="Sign out instead"
            HeightRequest="44"
            FontSize="14"
            Margin="0,24,0,0"
            BackgroundColor="Transparent"
            TextColor="#B3261E"
            Command="{Binding SignOutCommand}" />

    </VerticalStackLayout>
</ContentPage>
