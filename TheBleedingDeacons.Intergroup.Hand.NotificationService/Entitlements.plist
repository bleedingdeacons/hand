<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		The extension half of the pair. Both bundles must declare the same
		keychain access group, and the group must be registered against the
		team in the Apple Developer account, or SharedKeychain compiles
		perfectly and reads nothing at runtime.
	-->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)group.com.bleedingdeacons.hand</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.bleedingdeacons.hand</string>
	</array>
</dict>
</plist>
