<Project Sdk="Microsoft.NET.Sdk">

	<!--
		Unit tests for Hand.Core. Same arrangement as Register's test
		project, down to the runner: xUnit v3 on Microsoft.Testing.Platform,
		with coverage collected in CI by the coverlet.console tool.

		It references Hand.Core and not the app, because it cannot reference
		the app — see the note at the top of Hand.Core's project file.
	-->

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- xUnit v3 test projects are executables that host Microsoft.Testing.Platform. -->
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<!-- Run through Microsoft.Testing.Platform (not VSTest) under `dotnet test`. -->
		<TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
		<UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
		<!-- Test project: exempt from the repo's strict analyzer gate. -->
		<RunAnalyzers>false</RunAnalyzers>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="xunit.v3" Version="4.0.0" />
		<PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
		<!--
			Coverage is collected in CI with the coverlet.console tool (see
			.config/dotnet-tools.json), which wraps the Microsoft.Testing.Platform
			test executable. coverlet's collector/msbuild integrations hook VSTest,
			which MTP does not use, so they are intentionally not referenced here.
		-->
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\TheBleedingDeacons.Intergroup.Hand.Core\TheBleedingDeacons.Intergroup.Hand.Core.csproj" />
	</ItemGroup>

</Project>
